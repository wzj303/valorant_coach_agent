# Real LLM used by agent.llm_adapter.RealLlmAdapter.
# The model MUST support image input and tool calling.
# Export these in your shell (PowerShell: $env:VALORANT_LLM_API_KEY = "...").

# "openai"    -> POST {BASE_URL}/chat/completions (OpenAI-compatible)
# "anthropic" -> POST {BASE_URL}/v1/messages      (Anthropic Messages API)
VALORANT_LLM_FORMAT=openai
VALORANT_LLM_BASE_URL=https://api.example.com/v1
VALORANT_LLM_API_KEY=
VALORANT_LLM_MODEL=

# Optional
# VALORANT_LLM_TIMEOUT_S=120
# VALORANT_LLM_MAX_TOKENS=4096
# Set to 0 if the model/gateway has no vision support: requests with images
# then fail fast instead of silently dropping the screenshots.
# VALORANT_LLM_VISION=1
